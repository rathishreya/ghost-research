# Copy this file to `.env` and fill in your real key. Never commit `.env`.

# Required — Google AI Studio key (free tier).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional overrides
GHOST_IMAGE_MODEL=imagen-4.0-ultra-generate-001
GHOST_IMAGE_MODEL_FAST=imagen-4.0-fast-generate-001
GHOST_EDIT_MODEL=gemini-2.5-flash-image
GHOST_VIDEO_MODEL=veo-3.0-fast-generate-001
GHOST_POLL_SECONDS=5
GHOST_TIMEOUT_SECONDS=600
